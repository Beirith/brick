NEXT_PUBLIC_MOCK_BRL_ADDRESS=
NEXT_PUBLIC_PROPERTY_FACTORY_ADDRESS=
NEXT_PUBLIC_PROPERTY_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_PROPERTY_INCOME_ADDRESS=
# Base URL used to build the rent-payment QR code, e.g. http://192.168.1.23:3000 (your
# machine's LAN address) or a public tunnel URL. Falls back to the browser's own origin
# ("localhost") when unset, which a phone on a different network cannot reach.
NEXT_PUBLIC_APP_URL=
# Server-only HSK Testnet private key for the demo rent payer. It mints and deposits
# fictional mBRL on behalf of anyone who scans a rent-payment QR code, so the payer never
# needs their own wallet or test HSK. Use a dedicated disposable testnet key, funded with a
# small amount of test HSK; never a mainnet or fund-holding key. Never prefix with NEXT_PUBLIC_.
DEMO_PAYER_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Set true only for a clearly labeled, deterministic demo fallback without an LLM call.
AI_MOCK_MODE=false
