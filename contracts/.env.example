# Local Anvil RPC. Use a Foundry keystore account to sign deployments.
RPC_URL=http://127.0.0.1:8545
# Optional address allowed to publish AI-generated proposals. The property creator can always publish them.
AI_AGENT_ADDRESS=0x0000000000000000000000000000000000000000
# Used by DeployMarketplace.s.sol and DeployIncome.s.sol when adding/replacing pieces of an
# existing Brick deployment without recreating the factory or its properties.
PROPERTY_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
MOCK_BRL_ADDRESS=0x0000000000000000000000000000000000000000
# Used only by DeployIncome.s.sol; must be the marketplace the frontend currently points to.
PROPERTY_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
